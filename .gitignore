# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# GoldSky is a two-app monorepo: frontend/ (Next.js) and backend/ (Laravel).

### Frontend (Next.js) ###

# dependencies
/frontend/node_modules
/frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# testing
/frontend/coverage

# next.js
/frontend/.next/
/frontend/out/

# production
/frontend/build

# env files (can opt-in for committing if needed)
frontend/.env*

# vercel
frontend/.vercel

# typescript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

### Backend (Laravel) ###

/backend/vendor
/backend/node_modules
/backend/.env
/backend/.env.backup
/backend/.env.production
/backend/.phpunit.result.cache
/backend/Homestead.json
/backend/Homestead.yaml
/backend/auth.json
/backend/npm-debug.log
/backend/yarn-error.log
/backend/storage/*.key
/backend/storage/pail
/backend/storage/app/public/*
!/backend/storage/app/public/.gitkeep
/backend/storage/framework/cache/*
!/backend/storage/framework/cache/.gitkeep
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitkeep
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitkeep
/backend/storage/logs/*
!/backend/storage/logs/.gitkeep
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore
/backend/public/hot
/backend/public/storage
/backend/public/build

### Stray root-level artifacts (pre-restructure) ###

/.next/
/node_modules/
/next-env.d.ts

### Misc ###

.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json
